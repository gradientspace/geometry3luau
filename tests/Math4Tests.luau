-- Tests for Vector4d, Matrix4d, VectorTuple and MathUtil.TryParseRealVector.

return function(G3, h)
	local Vector4d = G3.Vector4d
	local Matrix4d = G3.Matrix4d
	local V4 = Vector4d.new
	local V = G3.Vector3d.new

	local function nearV3(a, b, eps, msg)
		h.truthy(a:EpsilonEqual(b, eps or 1e-9), (msg or "") .. ": " .. tostring(a) .. " vs " .. tostring(b))
	end

	h:test("Vector4d basics", function()
		local a = V4(1, 2, 3, 4)
		local b = V4(-1, 0.5, 2, 1)
		h.eq(a:Dot(b), -1 + 1 + 6 + 4)
		h.eq(a:LengthSquared(), 30)
		h.near(a:Length(), math.sqrt(30))
		h.eq(a:LengthL1(), 10)
		h.eq(a + b, V4(0, 2.5, 5, 5))
		h.eq(a - b, V4(2, 1.5, 1, 3))
		h.eq(a * 2, V4(2, 4, 6, 8))
		h.eq(2 * a, V4(2, 4, 6, 8))
		h.eq(a * b, V4(-1, 1, 6, 4))
		h.eq(a / 2, V4(0.5, 1, 1.5, 2))
		h.eq(-a, V4(-1, -2, -3, -4))
		h.eq(a + 1, V4(2, 3, 4, 5))
		h.eq(a - 1, V4(0, 1, 2, 3))
		h.eq(a:Get(0), 1)
		h.eq(a:Get(3), 4)
		h.eq(a:With(2, 9), V4(1, 2, 9, 4))
		h.eq(a, V4(1, 2, 3, 4), "With must not mutate")
		h.near(a:Distance(b), (a - b):Length())
		h.near(a:DistanceSquared(b), (a - b):LengthSquared())
		h.eq(a:CompareTo(b), 1)
		h.eq(a:CompareTo(a:Clone()), 0)
		h.truthy(a:Equals(V4(1, 2, 3, 4)))
		h.truthy(a:IsFinite())
		h.truthy(not V4(0, 0, 0 / 0, 0):IsFinite())
		h.eq(Vector4d.FromArray({ 9, 1, 2, 3, 4 }, 1), V4(1, 2, 3, 4))
		h.eq(Vector4d.Splat(2), V4(2, 2, 2, 2))
		h.truthy(V4(1.234, 2.345, 3.456, 4.567):RoundFrac(1):EpsilonEqual(V4(1.2, 2.3, 3.5, 4.6), 1e-12))
	end)

	h:test("Vector4d normalize and angles", function()
		local a = V4(3, 0, 4, 0)
		local n, len = a:NormalizedAndLength()
		h.near(len, 5)
		h.truthy(n:IsNormalized())
		h.truthy(a:Normalized():EpsilonEqual(V4(0.6, 0, 0.8, 0), 1e-12))
		local z, zl = Vector4d.Zero:NormalizedAndLength()
		h.eq(zl, 0)
		h.eq(z, Vector4d.Zero)
		h.near(Vector4d.UnitX:AngleD(Vector4d.UnitW), 90)
		h.near(Vector4d.UnitX:AngleR(Vector4d.UnitX), 0)
		local ok = pcall(function()
			(Vector4d.Zero :: any).x = 1
		end)
		h.truthy(not ok, "constants are frozen")
	end)

	h:test("TryParse", function()
		local ok, v = G3.MathUtil.TryParseRealVector("1, 2.5,-3 4", 4)
		h.truthy(ok)
		h.eq(v, V4(1, 2.5, -3, 4))
		ok = G3.MathUtil.TryParseRealVector("1 2 3", 4)
		h.truthy(not ok)
		ok = G3.MathUtil.TryParseRealVector("1 x 3", 3)
		h.truthy(not ok)
		local ok3, v3 = G3.Vector3d.TryParse("1,2,3")
		h.truthy(ok3)
		h.eq(v3, V(1, 2, 3))
		ok3 = G3.Vector3d.TryParse("1 2 y")
		h.truthy(not ok3)
		local ok2, v2 = G3.Vector2d.TryParse("4 5")
		h.truthy(ok2)
		h.eq(v2, G3.Vector2d.new(4, 5))
		h.truthy(not (G3.Vector2d.TryParse("4 5 6")))
	end)

	local M = Matrix4d.new(2, 1, 0, 3, 0, 1, 4, 1, 1, 0, 2, 0, 3, 1, 1, 5)

	h:test("Matrix4d constructors and access", function()
		h.truthy(Matrix4d.Identity:IsIdentity())
		h.truthy(Matrix4d.Identity:IsAffine())
		h.truthy(not M:IsAffine())
		h.eq(M:Get(1, 2), 4)
		h.eq(M:GetLinear(6), 4)
		h.eq(M:GetLinear(15), 5)
		h.eq(M:With(3, 0, 7):Get(3, 0), 7)
		h.eq(M:Get(3, 0), 3, "With must not mutate")
		h.eq(M:WithLinear(9, 8):Get(2, 1), 8)
		h.eq(M:Row(2), V4(1, 0, 2, 0))
		h.eq(M:Column(3), V4(3, 1, 0, 5))
		local c0, c1, c2, c3 = M:GetColumns()
		h.eq(c0, V4(2, 0, 1, 3))
		h.eq(c1, V4(1, 1, 0, 1))
		h.eq(c2, V4(0, 4, 2, 1))
		h.eq(c3, V4(3, 1, 0, 5))
		local buf = M:ToBuffer()
		h.eq(#buf, 16)
		h.eq(Matrix4d.FromArray(buf), M)
		local buf2 = {}
		M:ToBuffer(buf2)
		h.eq(buf2[8], 1)
		h.eq(buf2[16], 5)
		h.eq(
			Matrix4d.FromFunc(function(i)
				return buf[i + 1]
			end),
			M
		)
		h.eq(
			Matrix4d.FromFunc2(function(r, c)
				return M:Get(r, c)
			end),
			M
		)
		h.eq(Matrix4d.FromArray2D({ { 2, 1, 0, 3 }, { 0, 1, 4, 1 }, { 1, 0, 2, 0 }, { 3, 1, 1, 5 } }), M)
		h.eq(Matrix4d.FromVectors(M.Row0, M.Row1, M.Row2, M.Row3, true), M)
		h.eq(Matrix4d.FromVectors(c0, c1, c2, c3, false), M)
		h.eq(Matrix4d.Diagonal(1, 2, 3, 4):Get(2, 2), 3)
		local op = Matrix4d.OuterProduct(V4(1, 2, 3, 4), V4(1, 0, 2, 1))
		h.eq(op:Row(3), V4(4, 0, 8, 4))
		h.eq(op:Row(2), V4(3, 0, 6, 3))
	end)

	h:test("Matrix4d arithmetic", function()
		h.eq(M * Matrix4d.Identity, M)
		h.eq(Matrix4d.Identity * M, M)
		h.eq(M * V4(1, 0, 0, 0), M:Column(0))
		h.eq(M:Multiply(V4(1, 1, 1, 1)), V4(6, 6, 3, 10))
		h.eq((M * 2):Get(3, 3), 10)
		h.eq((2 * M):Get(3, 3), 10)
		h.eq((M + M):Get(0, 0), 4)
		h.eq((M - M), Matrix4d.Zero)
		h.eq(M:InnerProduct(Matrix4d.Identity), 2 + 1 + 2 + 5)
		h.eq(M:Transpose():Get(0, 3), M:Get(3, 0))
		h.eq(M:Transpose():Transpose(), M)
		-- (AB)^T = B^T A^T
		local B = Matrix4d.FromMatrix3(G3.Matrix3d.AxisAngleD(V(0, 0, 1), 30), V(1, 2, 3))
		h.truthy((M * B):Transpose():EpsilonEqual(B:Transpose() * M:Transpose(), 1e-12))
		h.truthy(type(tostring(M)) == "string")
		h.truthy(type(M:ToString("%.2f")) == "string")
	end)

	h:test("Matrix4d determinant and inverse", function()
		h.near(Matrix4d.Identity:Determinant(), 1)
		h.near(Matrix4d.Diagonal(2, 3, 4, 5):Determinant(), 120)
		-- expected value computed by Laplace expansion along row 2
		h.near(M:Determinant(), 14, 1e-9)
		h.near(M:Transpose():Determinant(), M:Determinant(), 1e-9)
		local Mi = M:Inverse()
		h.truthy((M * Mi):EpsilonEqual(Matrix4d.Identity, 1e-12), "M * Minv")
		h.truthy((Mi * M):EpsilonEqual(Matrix4d.Identity, 1e-12), "Minv * M")
		-- det(AB) = det(A) det(B)
		local B = Matrix4d.new(1, 2, 0, 1, 0, 1, 1, 0, 2, 0, 1, 1, 1, 1, 0, 3)
		h.near((M * B):Determinant(), M:Determinant() * B:Determinant(), 1e-9)
		-- affine path
		local A = Matrix4d.FromQuaternion(G3.Quaterniond.AxisAngleD(V(1, 1, 0):Normalized(), 40), V(3, -2, 1))
			* Matrix4d.Scale(V(2, 3, 0.5))
		h.truthy(A:IsAffine())
		local Ai = A:Inverse()
		h.truthy((A * Ai):EpsilonEqual(Matrix4d.Identity, 1e-12), "affine inverse")
		local ok = pcall(function()
			Matrix4d.new(1, 2, 3, 4, 2, 4, 6, 8, 0, 0, 1, 0, 1, 1, 1, 1):Inverse()
		end)
		h.truthy(not ok, "singular matrix inverse errors")
	end)

	h:test("Matrix4d affine transforms", function()
		local p = V(1, 2, 3)
		h.eq(Matrix4d.Translation(V(1, 1, 1)):TransformPointAffine(p), V(2, 3, 4))
		h.eq(Matrix4d.Translation(V(1, 1, 1)):TransformVectorAffine(p), p)
		h.eq(Matrix4d.Scale(V(2, 3, 4)):TransformPointAffine(p), V(2, 6, 12))
		nearV3(Matrix4d.AxisAngleDeg(V(0, 0, 1), 90):TransformPointAffine(V(1, 0, 0)), V(0, 1, 0), 1e-12, "rotate")
		h.truthy(Matrix4d.Affine(G3.Matrix3d.Identity):IsIdentity())
		local frame = G3.Frame3d.new(V(5, -1, 2), G3.Quaterniond.AxisAngleD(V(0.3, 1, -0.2):Normalized(), 63))
		local F = Matrix4d.FromFrame(frame)
		nearV3(F:TransformPointAffine(p), frame:FromFrameP(p), 1e-12, "FromFrame point")
		nearV3(F:TransformVectorAffine(p), frame:FromFrameV(p), 1e-12, "FromFrame vector")
		nearV3(F:Inverse():TransformPointAffine(p), frame:ToFrameP(p), 1e-12, "inverse = ToFrame")
		h.eq(F:GetAffineTranslation(), V(5, -1, 2))
		-- normal transform for non-uniform scale keeps normals perpendicular to surfaces
		local S = Matrix4d.Scale(V(1, 4, 1))
		local ok, NT = S:GetAffineNormalTransform()
		h.truthy(ok)
		local tangent = V(1, 1, 0)
		local normal = V(1, -1, 0)
		h.near(S:TransformVectorAffine(tangent):Dot(NT * normal), 0, 1e-12)
		local ok2, NT2 = M:GetAffineNormalTransform()
		h.truthy(not ok2)
		h.eq(NT2, G3.Matrix3d.Identity)
	end)

	h:test("VectorTuple", function()
		local VT = G3.VectorTuple
		local t = VT.Vector3dTuple3(V(1, 0, 0), V(0, 1, 0))
		h.eq(#t, 3)
		h.eq(t[2], V(0, 1, 0))
		h.eq(t[3], G3.Vector3d.Zero)
		h.eq(#VT.Vector3dTuple2(), 2)
		h.eq(#VT.Vector2dTuple2(), 2)
		h.eq(#VT.Vector2dTuple3(), 3)
		local t4 = VT.Vector2dTuple4(nil, nil, G3.Vector2d.new(1, 2))
		h.eq(#t4, 4)
		h.eq(t4[3], G3.Vector2d.new(1, 2))
	end)

	return h:results()
end
